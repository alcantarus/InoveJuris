# App Environment (production or test)
NEXT_PUBLIC_APP_ENV=test

# Supabase Configuration
# Option 1: Separate Environments (Recommended)
# Production
NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=
# Test
NEXT_PUBLIC_SUPABASE_URL_TEST=
NEXT_PUBLIC_SUPABASE_ANON_KEY_TEST=

# Option 2: Single Environment (Fallback)
# If you only have one Supabase project, you can use these standard variables.
# They will be used for BOTH production and test environments if the specific ones above are missing.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Datajud API Configuration
# Obrigatória: chave de API própria, emitida pelo CNJ. A chave compartilhada que antes ficava no código foi removida.
DATAJUD_API_KEY=

# Email OAuth2 Configuration
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# Gemini API (somente servidor — unica fonte autorizada da chave)
GEMINI_API_KEY=
# Modelo usado nas chamadas (opcional; padrao: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Timezone Configuration
TZ=America/Sao_Paulo

# Backup Agent Configuration (Supabase Connection Pooler)
# Exemplo: postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:5432/postgres
DB_URL_POOLER=
# Recomendada para /api/process-sync gravar andamentos e status de sincronização via service role.
# Se ausente, a rota usa a anon key e o RPC set_app_environment.
SUPABASE_SERVICE_ROLE_KEY=

# Identidade no banco (F4b-2b / Fase A) — somente servidor.
# Opção 1 (recomendada): JWK privado ES256 da chave atual do projeto
# (Supabase: Project Settings > API > JWT Keys).
# SUPABASE_JWT_PRIVATE_JWK={"kty":"EC","crv":"P-256","d":"...","x":"...","y":"...","kid":"..."}
# SUPABASE_JWT_KID=
# Opção 2: segredo compartilhado legado (HS256), aceito enquanto a chave antiga
# ainda constar em "Previously used keys".
# SUPABASE_JWT_SECRET=
# Fase A: role=anon (padrão). Fase B: role=authenticated.
# SUPABASE_JWT_ROLE=anon
